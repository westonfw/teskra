{
  "name": "@teskra/desktop",
  "productName": "Teskra",
  "version": "0.1.0",
  "private": true,
  "description": "Teskra desktop application (Electron).",
  "main": "./out/main/index.js",
  "build": {
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**"
    ]
  },
  "scripts": {
    "postinstall": "install-electron && electron-rebuild",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@teskra/contracts": "0.1.0",
    "@teskra/shared": "0.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.3",
    "better-sqlite3": "13.0.3",
    "node-pty": "1.1.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
