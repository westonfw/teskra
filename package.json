{
  "name": "teskra",
  "version": "0.1.0",
  "private": true,
  "description": "Teskra — Multi-Agent Coding Workbench. Orchestrate your coding agents.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "npm run dev --workspace @teskra/desktop",
    "build": "npm run build --workspace @teskra/desktop",
    "dist": "npm run dist --workspace @teskra/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:security": "npm run build && node scripts/assert-security-baseline.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
